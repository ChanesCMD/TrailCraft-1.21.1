{
  "multipart": [
    {
      "apply": {
        "model": "trailcraft:block/iron_support_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "trailcraft:block/iron_support_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "trailcraft:block/iron_support_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "trailcraft:block/iron_support_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "trailcraft:block/iron_support_arm",
        "y": 270
      }
    }
  ]
}
