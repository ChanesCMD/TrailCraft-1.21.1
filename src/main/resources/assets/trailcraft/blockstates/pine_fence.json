{
  "multipart": [
    {
      "apply": {
        "model": "trailcraft:block/pine_fence_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "trailcraft:block/pine_fence_side",
        "uvlock": true
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "trailcraft:block/pine_fence_side",
        "uvlock": true,
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "trailcraft:block/pine_fence_side",
        "uvlock": true,
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "trailcraft:block/pine_fence_side",
        "uvlock": true,
        "y": 270
      }
    },
    {
      "when": {
        "diagonal_south_east": "true"
      },
      "apply": {
        "model": "trailcraft:block/pine_fence_diagonal",
        "y": 0
      }
    },
    {
      "when": {
        "diagonal_north_east": "true"
      },
      "apply": {
        "model": "trailcraft:block/pine_fence_diagonal",
        "y": 90
      }
    },
    {
      "when": {
        "diagonal_north_west": "true"
      },
      "apply": {
        "model": "trailcraft:block/pine_fence_diagonal",
        "y": 180
      }
    },
    {
      "when": {
        "diagonal_south_west": "true"
      },
      "apply": {
        "model": "trailcraft:block/pine_fence_diagonal",
        "y": 270
      }
    }
  ]
}
